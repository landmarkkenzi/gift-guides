<style>
/* =========================================
   GIFT GUIDE IMAGE
   ========================================= */
.gift-guide-fullscreen {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  /* removed: height: 50vh; */
}

.gift-guide-map-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1280 / 854;
  margin: 0 auto;
}

.gift-guide-map-image {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  float: none !important;
  object-fit: cover;
}


/* =========================================
   MAP MARKERS
   ========================================= */

.gift-guide-marker {
  position: absolute;
  width: clamp(25px, 2.2vw, 42px);
  height: clamp(25px, 2.2vw, 42px);
  transform: translate(-50%, -50%);
  padding: 0;
  margin: 0;
  border: 2px solid #f43f00;
  border-radius: 50%;
  background: #f43f00;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  appearance: none;
  -webkit-appearance: none;
  font-family: Arial, sans-serif;
  font-size: clamp(18px, 2vw, 28px);
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;


  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}


/* PLUS SIGN */
.gift-guide-marker::before {
  content: "+";
  display: block;
  line-height: 1;
}


/* Hover */
.gift-guide-marker:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
  color: #383838;
  border-color: #383838;
}


/* Keyboard focus */
.gift-guide-marker:focus-visible {
  outline: 3px solid #383838;
  outline-offset: 4px;
}


/* =========================================
   MODAL
   ========================================= */

.gift-guide-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 30px;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.72);
  z-index: 999999;
  line-height: normal;
}

.gift-guide-modal.is-open {
  display: flex;
}


/* =========================================
   MODAL CONTENT
   ========================================= */

.gift-guide-modal-content {
  position: relative;
  width: min(1100px, 100%);
  max-height: calc(100vh - 60px);
  overflow-y: auto;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 8px;
  padding: 32px 32px 32px;
}


/* Park name */

.gift-guide-modal-title {
  margin: 0 0 24px;
  padding: 0;
  color: #383838;
  font-family: inherit;
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}


/* =========================================
   SHOPPABLE PRODUCT GRID
   ========================================= */

.gift-guide-shop-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}

.gift-guide-shop-card {
  flex: 0 1 calc((100% - 48px) / 3); 
  max-width: 300px;                 
  display: flex;
  flex-direction: column;
  text-align: center;
  text-decoration: none;
  color: inherit;
}
.gift-guide-shop-card img {
  display: block;
  position: static;
  width: 100%;
  max-width: 100%;
  height: auto;
  aspect-ratio: 1 / 1;
  object-fit: cover;
  margin: 0 0 10px;
  transform: none;
  float: none;
  border-radius: 4px;
  background: #f4f4f4;
}

.gift-guide-shop-card,
.gift-guide-shop-card:hover {
  text-decoration: none;
  border-bottom: 0;
  background-image: none;
}

.gift-guide-shop-card__title,
.gift-guide-shop-card__price {
  margin: 0 0 4px;
}

.gift-guide-shop-empty {
  text-align: center;
  color: #777;
  padding: 40px 0;
  margin: 0;
}


/* =========================================
   CLOSE BUTTON
   ========================================= */

.gift-guide-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #383838;
  font-family: Arial, sans-serif;
  font-size: 25px;
  line-height: 38px;
  text-align: center;
  cursor: pointer;
  z-index: 20;
  appearance: none;
  -webkit-appearance: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}

.gift-guide-modal-close:hover {
  background: #383838;
  color: #ffffff;
}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {

  .gift-guide-fullscreen {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }

  .gift-guide-marker {
    width: clamp(24px, 6vw, 30px);
    height: clamp(24px, 6vw, 30px);
    font-size: clamp(18px, 5vw, 24px);
  }

  .gift-guide-modal {
    padding: 15px;
  }

  .gift-guide-modal-content {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 30px);
    padding: 32px 18px 24px;
  }

  .gift-guide-modal-title {
    font-size: 20px;
    margin-bottom: 18px;
  }

  .gift-guide-shop-grid {
  gap: 20px;
}

.gift-guide-shop-card {
  flex: 0 1 100%;
  max-width: 320px;
}

  .gift-guide-modal-close {
    top: 8px;
    right: 8px;

    width: 34px;
    height: 34px;

    font-size: 23px;
    line-height: 34px;
  }
}
</style>


<!-- =========================================
     MAP
     ========================================= -->

<div class="gift-guide-fullscreen">

  <div class="gift-guide-map-wrapper">

    <img class="gift-guide-map-image" src="https://cdn.shopify.com/s/files/1/1529/3721/files/2026_Gift_Guide-Smokey-1280x854-e8ff21e.jpg?v=1793282223" alt="Gifts for the Smokey Superfan">

    <!-- MARKERS -->

    <button type="button" class="gift-guide-marker" style="left:50%;top:10%;" data-name="Smokey Bear Accessories"></button>

    <button type="button" class="gift-guide-marker" style="left:33%;top:30%;" data-name="Smokey Bear Unisex Sweater"></button>

    <button type="button" class="gift-guide-marker" style="left:71%;top:60%;" data-name="Smokey Bear Unisex Half Zip Fleece"></button>

    <button type="button" class="gift-guide-marker" style="left:76%;top:44%;" data-name="Smokey Bear Postage Stamp Pin"></button>

    <button type="button" class="gift-guide-marker" style="left:23%;top:56%;" data-name="2027 Smokey Bear Calendar"></button>

    <button type="button" class="gift-guide-marker" style="left:43%;top:54%;" data-name="Smokey Bear Bandana"></button>

    <button type="button" class="gift-guide-marker" style="left:64%;top:26%;" data-name="Smokey Logo Enamel Mug"></button>

    <button type="button" class="gift-guide-marker" style="left:61%;top:7%;" data-name="Smokey Bear and Friends Beanie"></button>

    <button type="button" class="gift-guide-marker" style="left:77%;top:7%;" data-name="Smokey Emblem Sock"></button>

    <button type="button" class="gift-guide-marker" style="left:90%;top:32%;" data-name="Smokey Bear Pennant 5-Panel Hat"></button>

    <button type="button" class="gift-guide-marker" style="left:15%;top:10%;" data-name="Smokey Bear Jigsaw Puzzle"></button>

  </div>

</div>


<!-- =========================================
     MODAL JAVASCRIPT
     ========================================= -->

<script>
(function() {

  const modal = document.getElementById('gift-guide-modal');
  const modalTitle = document.getElementById('gift-guide-modal-title');
  const modalClose = document.getElementById('gift-guide-modal-close');
  const shopGrid = document.getElementById('gift-guide-shop-grid');
  const shopEmpty = document.getElementById('gift-guide-shop-empty');

  if (!modal || !modalTitle || !modalClose || !shopGrid || !shopEmpty) {
    return;
  }

  /* =========================================
     PRODUCT HANDLES PER PARK
     Fill in the handles for each park below.
     A handle is the part of the URL after
     /products/  e.g. /products/trail-mug
     ========================================= */

  const PARK_PRODUCTS = {
    'Smokey Bear Accessories': [ 'only-you-retro-sticker' , 'prevent-wildfires-keychain','i-love-smokey-magnet'],
    'Smokey Bear Unisex Sweater': ['smokey-bear-unisex-sweater'],
    'Smokey Bear Unisex Half Zip Fleece': ['smokey-bear-unisex-half-zip-fleece'],
    'Smokey Bear Postage Stamp Pin': ['smokey-bear-postage-stamp-pin'],
    '2027 Smokey Bear Calendar': ['2027-smokey-bear-calendar'],
    'Smokey Bear Bandana': ['smokey-bear-bandana'],
    'Smokey Logo Enamel Mug': ['smokey-logo-enamel-mug'],
    'Smokey Bear and Friends Beanie': ['smokey-bear-and-friends-beanie'],
    'Smokey Emblem Sock': ['smokey-emblem-sock'],
    'Smokey Bear Pennant 5-Panel Hat': [ 'Smokey-Bear-Pennant-5-Panel-Hat'],


   /* =========================================
     HOW PRODUCTS ARE ADDED
     'Big Bend National Park': [ 'big-bend-national-park-poster','big-bend-gear-tag' ]
     ========================================= */

  };

  const productCache = {};

  function formatMoney(cents) {
    // Adjust if your store's currency/locale isn't USD
    return '$' + (cents / 100).toFixed(2);
  }

  function fetchProduct(handle) {
    if (productCache[handle]) {
      return Promise.resolve(productCache[handle]);
    }
    return fetch('/products/' + handle + '.js')
      .then(function(res) {
        if (!res.ok) throw new Error('Not found: ' + handle);
        return res.json();
      })
      .then(function(data) {
        productCache[handle] = data;
        return data;
      })
      .catch(function(err) {
        console.warn('Could not load product', handle, err);
        return null;
      });
  }

  function buildCard(product) {
    const variant = product.variants && product.variants[0];
    const price = variant ? formatMoney(variant.price) : '';
    const image = product.featured_image || (product.images && product.images[0]) || '';

    const a = document.createElement('a');
    a.className = 'gift-guide-shop-card';
    a.href = '/products/' + product.handle;

    a.innerHTML =
      (image ? '<img src="' + image + '" alt="' + product.title + '" loading="lazy">' : '') +
      '<p class="gift-guide-shop-card__title">' + product.title + '</p>' +
      '<p class="gift-guide-shop-card__price">' + price + '</p>';

    return a;
  }


  /* =========================================
     OPEN MODAL
     ========================================= */

  document.addEventListener('click', function(event) {

    const marker = event.target.closest('.gift-guide-marker');
    if (!marker) return;

    const name = marker.getAttribute('data-name');
    const handles = PARK_PRODUCTS[name] || [];

    modalTitle.textContent = name;
    shopGrid.innerHTML = '';
    shopEmpty.hidden = true;

    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    if (!handles.length) {
      shopEmpty.hidden = false;
      return;
    }

    Promise.all(handles.map(fetchProduct)).then(function(products) {
      const found = products.filter(Boolean);
      if (!found.length) {
        shopEmpty.hidden = false;
        return;
      }
      found.forEach(function(product) {
        shopGrid.appendChild(buildCard(product));
      });
    });

  });


  /* =========================================
     CLOSE MODAL
     ========================================= */

  function closeModal() {

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    modalTitle.textContent = '';
    shopGrid.innerHTML = '';
    shopEmpty.hidden = true;

    document.body.style.overflow = '';

  }


  modalClose.addEventListener('click', closeModal);


  /* =========================================
     CLOSE WHEN CLICKING OUTSIDE CONTENT
     ========================================= */

  modal.addEventListener('click', function(event) {

    if (event.target === modal) {
      closeModal();
    }

  });


  /* =========================================
     CLOSE WITH ESCAPE KEY
     ========================================= */

  document.addEventListener('keydown', function(event) {

    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }

  });

})();
</script>
