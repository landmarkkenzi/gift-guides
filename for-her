<style>
/* =========================================
   GIFT GUIDE IMAGE
   ========================================= */
.gift-guide-fullscreen {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 0;
  overflow: hidden;
  box-sizing: border-box;
  /* removed: height: 50vh; */
}

.gift-guide-map-wrapper {
  position: relative;
  width: 100%;
  aspect-ratio: 1280 / 854;
  margin: 0 auto;
}

.gift-guide-map-image {
  display: block !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 100% !important;
  height: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  float: none !important;
  object-fit: cover;
}


/* =========================================
   MAP MARKERS
   ========================================= */

.gift-guide-marker {
  position: absolute;
  width: clamp(25px, 2.2vw, 42px);
  height: clamp(25px, 2.2vw, 42px);
  transform: translate(-50%, -50%);
  padding: 0;
  margin: 0;
  border: 2px solid #f43f00;
  border-radius: 50%;
  background: #f43f00;
  color: #ffffff;
  cursor: pointer;
  z-index: 10;
  appearance: none;
  -webkit-appearance: none;
  font-family: Arial, sans-serif;
  font-size: clamp(18px, 2vw, 28px);
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;


  transition:
    transform 0.2s ease,
    background-color 0.2s ease,
    color 0.2s ease,
    border-color 0.2s ease;
}


/* PLUS SIGN */
.gift-guide-marker::before {
  content: "+";
  display: block;
  line-height: 1;
}


/* Hover */
.gift-guide-marker:hover {
  transform: translate(-50%, -50%) scale(1.15);
  background: #ffffff;
  color: #383838;
  border-color: #383838;
}


/* Keyboard focus */
.gift-guide-marker:focus-visible {
  outline: 3px solid #383838;
  outline-offset: 4px;
}



/* =========================================
   MODAL
   ========================================= */

.gift-guide-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 30px;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.72);
  z-index: 999999;
  line-height: normal;
}

.gift-guide-modal.is-open {
  display: flex;
}


/* =========================================
   MODAL CONTENT
   ========================================= */

.gift-guide-modal-content {
  position: relative;
  width: min(1100px, 100%);
  max-height: calc(100vh - 60px);
  overflow-y: auto;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 8px;
  padding: 32px 32px 32px;
}


/* Park name */

.gift-guide-modal-title {
  margin: 0 0 24px;
  padding: 0;
  color: #383838;
  font-family: inherit;
  font-size: 24px;
  font-weight: 600;
  line-height: 1.2;
  text-align: center;
}


/* =========================================
   SHOPPABLE PRODUCT GRID
   ========================================= */

.gift-guide-shop-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 24px;
}

.gift-guide-shop-card {
  align-items: center !important;
  text-align: center !important;
}

.gift-guide-shop-card__image {
  display: block !important;
  width: 100% !important;
  max-width: 100% !important;
  aspect-ratio: 1 / 1;
  height: auto;
  object-fit: cover;
  margin: 0 0 10px !important;
  padding: 0 !important;
  border-radius: 4px;
  background-color: #f4f4f4;
}

.gift-guide-shop-card__title,
.gift-guide-shop-card__price {
  width: 100%;
  text-align: center !important;
}

.gift-guide-shop-card,
.gift-guide-shop-card:hover {
  text-decoration: none;
  border-bottom: 0;
  background-image: none;
}


.gift-guide-shop-empty {
  text-align: center;
  color: #777;
  padding: 40px 0;
  margin: 0;
}


/* =========================================
   CLOSE BUTTON
   ========================================= */

.gift-guide-modal-close {
  position: absolute;
  top: 12px;
  right: 12px;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #ffffff;
  color: #383838;
  font-family: Arial, sans-serif;
  font-size: 25px;
  line-height: 38px;
  text-align: center;
  cursor: pointer;
  z-index: 20;
  appearance: none;
  -webkit-appearance: none;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2);
}

.gift-guide-modal-close:hover {
  background: #383838;
  color: #ffffff;
}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 749px) {
  .gift-guide-fullscreen {
    width: 100%;
    margin-left: 0;
    margin-right: 0;
  }

  .gift-guide-marker {
    width: clamp(24px, 6vw, 30px);
    height: clamp(24px, 6vw, 30px);
    font-size: clamp(18px, 5vw, 24px);
  }

  .gift-guide-modal {
    padding: 15px;
  }

  .gift-guide-modal-content {
    width: 100%;
    max-width: 100%;
    max-height: calc(100vh - 30px);
    padding: 32px 18px 24px;
  }

  .gift-guide-modal-title {
    font-size: 20px;
    margin-bottom: 18px;
  }

  .gift-guide-shop-grid {
  gap: 20px;
}

.gift-guide-shop-card {
  flex: 0 1 100%;
  max-width: 320px;
}

  .gift-guide-modal-close {
    top: 8px;
    right: 8px;

    width: 34px;
    height: 34px;

    font-size: 23px;
    line-height: 34px;
  }
}
</style>


