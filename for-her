<!-- =========================================
     MODAL JAVASCRIPT
     ========================================= -->

<script>
(function() {
console.count('Gift Guide script initialized');
  const modal = document.getElementById('gift-guide-modal');
  const modalTitle = document.getElementById('gift-guide-modal-title');
  const modalClose = document.getElementById('gift-guide-modal-close');
  const shopGrid = document.getElementById('gift-guide-shop-grid');
  const shopEmpty = document.getElementById('gift-guide-shop-empty');

  if (!modal || !modalTitle || !modalClose || !shopGrid || !shopEmpty) {
    return;
  }

  /* =========================================
     PRODUCT HANDLES PER PARK
     Fill in the handles for each park below.
     A handle is the part of the URL after
     /products/  e.g. /products/trail-mug
     ========================================= */

  const PARK_PRODUCTS = {
    'Woodsy Owl Bandana': [ 'Woodsy-Owl-Bandana'],
    'Tread Lightly Sock': ['Tread-Lightly-Sock'],
    'Poppy & Pout x The Landmark Project: Lip Balm Gift Set Trio Desert': ['poppy-pout-x-the-landmark-project-lip-balm-gift-set-trio-copy'],
    'Leave No Trace 5-Panel Camp Hat': ['leave-no-trace-camp-hat'],
    'Prismatic Sock': ['Prismatic-Sock'],
    'National Parks Pixels Enamel Mug': ['National-Parks-Pixels-Enamel-Mug'],
    'Woodsy Owl Retro Womens Short Sleeve Boxy Tee': ['woodsy-owl-retro-womens-short-sleeve-boxy-tee'],
    'Haven Womens Full Snap Sherpa Jacket': ['haven-womens-full-snap-sherpa-jacket'],
    'Babes in the Woods Womens Crewneck Sweatshirt': [ 'babes-in-the-woods-womens-crewneck-sweatshirt'],
    'Landmark Lodge Beanie': ['Landmark-Lodge-Beanie'],

   /* =========================================
     HOW PRODUCTS ARE ADDED
     'Big Bend National Park': [ 'big-bend-national-park-poster','big-bend-gear-tag' ]
     ========================================= */

  };

  const productCache = {};

  function formatMoney(cents) {
    // Adjust if your store's currency/locale isn't USD
    return '$' + (cents / 100).toFixed(2);
  }

  function fetchProduct(handle) {
    if (productCache[handle]) {
      return Promise.resolve(productCache[handle]);
    }
    return fetch('/products/' + handle + '.js')
      .then(function(res) {
        if (!res.ok) throw new Error('Not found: ' + handle);
        return res.json();
      })
      .then(function(data) {
        productCache[handle] = data;
        return data;
      })
      .catch(function(err) {
        console.warn('Could not load product', handle, err);
        return null;
      });
  }

 function buildCard(product) {
  const variant = product.variants && product.variants[0];
  const price = variant ? formatMoney(variant.price) : '';
  const image = product.featured_image || (product.images && product.images[0]) || '';

  const a = document.createElement('a');
  a.className = 'gift-guide-shop-card';
  a.href = '/products/' + product.handle;

  if (image) {
    const pic = document.createElement('img');
    pic.className = 'gift-guide-shop-card__image';
    pic.src = image;
    pic.alt = product.title;
    pic.loading = 'eager';

    a.appendChild(pic);
  }

  const title = document.createElement('p');
  title.className = 'gift-guide-shop-card__title';
  title.textContent = product.title;

  const productPrice = document.createElement('p');
  productPrice.className = 'gift-guide-shop-card__price';
  productPrice.textContent = price;

  a.appendChild(title);
  a.appendChild(productPrice);

  return a;
}


  /* =========================================
     OPEN MODAL
     ========================================= */

  document.addEventListener('click', function(event) {

    const marker = event.target.closest('.gift-guide-marker');
    if (!marker) return;

    const name = marker.getAttribute('data-name');
    const handles = PARK_PRODUCTS[name] || [];

modalTitle.textContent = name;

// Clear all previous product cards and images
shopGrid.replaceChildren();
shopEmpty.hidden = true;

// Reset modal content before loading new products
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';

    if (!handles.length) {
      shopEmpty.hidden = false;
      return;
    }

  Promise.all(handles.map(fetchProduct)).then(function(products) {
  const found = products.filter(Boolean);

  if (!found.length) {
    shopEmpty.hidden = false;
    return;
  }
// Only display one product per modal
const product = found[0];

if (product) {
  shopGrid.appendChild(buildCard(product));
}
});

  });


  /* =========================================
     CLOSE MODAL
     ========================================= */

  function closeModal() {

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    modalTitle.textContent = '';
    shopGrid.innerHTML = '';
    shopEmpty.hidden = true;

    document.body.style.overflow = '';

  }


  modalClose.addEventListener('click', closeModal);


  /* =========================================
     CLOSE WHEN CLICKING OUTSIDE CONTENT
     ========================================= */

  modal.addEventListener('click', function(event) {

    if (event.target === modal) {
      closeModal();
    }

  });


  /* =========================================
     CLOSE WITH ESCAPE KEY
     ========================================= */

  document.addEventListener('keydown', function(event) {

    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }

  });

})();
</script>
